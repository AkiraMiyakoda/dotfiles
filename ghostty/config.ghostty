theme = "Nord"
background-opacity = 0.95
cursor-style = block

window-inherit-working-directory = false
tab-inherit-working-directory = false

font-family = "UDEV Gothic"
font-size = 12

window-width = 160
window-height = 50
adjust-cell-height = 15%
window-padding-x = 8
window-padding-y = 4

clipboard-paste-protection = true

term = xterm-256color
env = LANG=ja_JP.UTF-8
